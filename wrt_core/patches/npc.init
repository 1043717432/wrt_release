#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

PROG=/usr/bin/npc
CONF=/tmp/etc/npc.conf

log_error() {
	logger -t npc -p daemon.err "$*"
}

uci_get() {
	uci -q get "npc.@npc[0].$1"
}

write_bool() {
	local name="$1"
	local value="$2"

	[ "$value" = "1" ] && value=true || value=false
	printf '%s=%s\n' "$name" "$value"
}

start_service() {
	local enable server_addr server_port protocol vkey
	local max_conn rate_limit flow_limit compress crypt

	enable="$(uci_get enable)"
	[ "$enable" = "1" ] || return 0

	server_addr="$(uci_get server_addr)"
	server_port="$(uci_get server_port)"
	protocol="$(uci_get protocol)"
	vkey="$(uci_get vkey)"
	max_conn="$(uci_get max_conn)"
	rate_limit="$(uci_get rate_limit)"
	flow_limit="$(uci_get flow_limit)"
	compress="$(uci_get compress)"
	crypt="$(uci_get crypt)"

	server_port="${server_port:-8024}"
	protocol="${protocol:-tcp}"
	compress="${compress:-0}"
	crypt="${crypt:-0}"

	[ -x "$PROG" ] || {
		log_error "npc binary is missing"
		return 1
	}
	[ -n "$server_addr" ] && [ -n "$vkey" ] || {
		log_error "server_addr and vkey are required"
		return 1
	}
	case "$server_port" in
		*[!0-9]*|'') log_error "invalid server_port: $server_port"; return 1 ;;
	esac
	case "$protocol" in
		tcp|kcp) ;;
		*) log_error "invalid protocol: $protocol"; return 1 ;;
	esac

	mkdir -p "${CONF%/*}" || return 1
	umask 077
	{
		printf '%s\n' '[common]'
		printf 'server_addr=%s:%s\n' "$server_addr" "$server_port"
		printf 'conn_type=%s\n' "$protocol"
		printf 'vkey=%s\n' "$vkey"
		printf '%s\n' 'auto_reconnection=true'
		[ -z "$max_conn" ] || printf 'max_conn=%s\n' "$max_conn"
		[ -z "$rate_limit" ] || printf 'rate_limit=%s\n' "$rate_limit"
		[ -z "$flow_limit" ] || printf 'flow_limit=%s\n' "$flow_limit"
		write_bool compress "$compress"
		write_bool crypt "$crypt"
	} >"$CONF" || {
		log_error "failed to create $CONF"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" -config="$CONF"
	procd_set_param file "$CONF"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f "$CONF"
}

service_triggers() {
	procd_add_reload_trigger npc
}
